rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الأدمن = حساب Firebase Authentication ببريد admin@reda-fr.app
    // (كلمة سره تُكتب في Firebase Console فقط وليست في أي ملف)
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@reda-fr.app';
    }
    function isActiveStudent() {
      return request.auth != null
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'active';
    }

    match /students/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);

      // إنشاء الحساب: الطالب ينشئ وثيقته فقط، ورقم الواتس لازم يطابق بريده
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.auth.token.email == request.resource.data.phone + '@students.reda-fr.app'
        && request.resource.data.keys().hasOnly(['name','phone','stage','system','grade','city','school','parentPhone','photo','status','devM','devD','createdAt','termsAcceptedAt']);

      // الطالب يعدّل بياناته فقط (لا يغيّر الحالة ولا الرقم). يُثبَّت له جهاز واحد هاتف (devM) وجهاز واحد كمبيوتر (devD)
      allow update: if isAdmin() || (
        request.auth != null
        && request.auth.uid == uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','stage','system','grade','city','school','parentPhone','photo','devM','devD','progress'])
        && (request.resource.data.get('devM','') == resource.data.get('devM','') || resource.data.get('devM','') == '')
        && (request.resource.data.get('devD','') == resource.data.get('devD','') || resource.data.get('devD','') == '')
      );

      allow delete: if isAdmin();
    }

    match /videos/{id} {
      allow read: if isAdmin() || isActiveStudent();
      allow write: if isAdmin();
    }

    match /files/{id} {
      allow read: if isAdmin() || isActiveStudent();
      allow write: if isAdmin();
    }

    // التعليقات: الطالب يضيف ويعدّل ويحذف تعليقه فقط، والأدمن يتحكم في الكل
    match /comments/{id} {
      allow read: if isAdmin() || isActiveStudent();
      allow create: if isActiveStudent()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['videoId','uid','name','photo','text','createdAt'])
        && request.resource.data.videoId is string
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 12
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      allow update: if isAdmin() || (isActiveStudent()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','edited','editedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500);
      allow delete: if isAdmin() || (isActiveStudent() && resource.data.uid == request.auth.uid);
    }

    // التقييم: تقييم واحد لكل طالب لكل فيديو (رقم المستند = videoId_uid)
    match /ratings/{rid} {
      allow read: if isAdmin() || isActiveStudent();
      allow create, update: if isActiveStudent()
        && request.resource.data.uid == request.auth.uid
        && rid == request.resource.data.videoId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['videoId','uid','value','updatedAt'])
        && request.resource.data.value is int && request.resource.data.value >= 1 && request.resource.data.value <= 5;
      allow delete: if isAdmin() || (isActiveStudent() && resource.data.uid == request.auth.uid);
    }

    // المدفوعات: الطالب يسجّل تحويله ويراه، والأدمن يؤكد أو يرفض أو يحذف
    match /payments/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if isActiveStudent()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','name','phone','stage','system','grade','method','amount','from','note','status','createdAt'])
        && request.resource.data.method in ['vodafone','instapay']
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 100000
        && request.resource.data.from is string && request.resource.data.from.size() <= 20
        && request.resource.data.note is string && request.resource.data.note.size() <= 200;
      allow update, delete: if isAdmin();
    }
    // الواجبات: المدرس يضيفها، والطالب النشط يقرؤها
    match /homework/{id} {
      allow read: if isAdmin() || isActiveStudent();
      allow write: if isAdmin();
    }

    // تسليمات الواجبات (رقم المستند = hwId_uid): الطالب يسلّم حلّه ويعدّله قبل التصحيح، والمدرس يصحّح
    match /hwsubs/{sid} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if isActiveStudent()
        && request.resource.data.uid == request.auth.uid
        && sid == request.resource.data.hwId + '_' + request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.keys().hasOnly(['hwId','uid','name','phone','status','link','note','updatedAt'])
        && request.resource.data.link is string && request.resource.data.link.size() <= 500
        && request.resource.data.note is string && request.resource.data.note.size() <= 300;
      allow update: if isAdmin() || (isActiveStudent()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'submitted'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.keys().hasOnly(['hwId','uid','name','phone','status','link','note','updatedAt'])
        && request.resource.data.link is string && request.resource.data.link.size() <= 500
        && request.resource.data.note is string && request.resource.data.note.size() <= 300);
      allow delete: if isAdmin();
    }

  }
}
