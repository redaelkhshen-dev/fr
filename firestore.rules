rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الأدمن = حساب Firebase Authentication ببريد admin@reda-fr.app
    // (كلمة سره تُكتب في Firebase Console فقط وليست في أي ملف)
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@reda-fr.app';
    }
    function isActiveStudent() {
      return request.auth != null
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'active';
    }

    match /students/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);

      // إنشاء الحساب: الطالب ينشئ وثيقته فقط، ورقم الواتس لازم يطابق بريده
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.auth.token.email == request.resource.data.phone + '@students.reda-fr.app'
        && request.resource.data.keys().hasOnly(['name','phone','stage','system','grade','city','school','parentPhone','photo','status','deviceId','createdAt','termsAcceptedAt']);

      // الطالب يعدّل بياناته فقط (لا يغيّر الحالة ولا الرقم، والجهاز يُثبَّت مرة واحدة)
      allow update: if isAdmin() || (
        request.auth != null
        && request.auth.uid == uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','stage','system','grade','city','school','parentPhone','photo','deviceId','progress'])
        && (request.resource.data.deviceId == resource.data.deviceId || resource.data.deviceId == '')
      );

      allow delete: if isAdmin();
    }

    match /videos/{id} {
      allow read: if isAdmin() || isActiveStudent();
      allow write: if isAdmin();
    }

    match /files/{id} {
      allow read: if isAdmin() || isActiveStudent();
      allow write: if isAdmin();
    }
  }
}
