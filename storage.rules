rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /files/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.token.email == 'admin@reda-fr.app'
        && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
